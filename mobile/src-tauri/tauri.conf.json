{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portal",
  "version": "0.1.0",
  "identifier": "com.tanvoid0.portal.mobile",
  "build": {
    "beforeDevCommand": "node frontend.mjs dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node frontend.mjs build",
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [{ "title": "Portal" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
