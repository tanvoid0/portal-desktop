{
  "name": "portal_desktop",
  "private": true,
  "version": "0.12.2",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 1420 || echo 'Port 1420 not in use'",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint src && node scripts/check-shadcn-ui.mjs",
    "test:unit": "vitest",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "n8n:start": "cd n8n-workflows && npx n8n start",
    "n8n:dev": "cd n8n-workflows && npx n8n start --tunnel",
    "ollama:install": "curl -fsSL https://ollama.ai/install.sh | sh",
    "ollama:models": "ollama pull llama3.2:3b && ollama pull codellama:7b && ollama pull mistral:7b",
    "ollama:serve": "ollama serve",
    "ai:setup": "pnpm ollama:install && pnpm ollama:models",
    "ai:test": "node test-ollama-integration.js",
    "run:install": "node scripts/install.js",
    "postrun:install": "echo 'Installation complete - no build tools required'",
    "postupdate": "cargo update --manifest-path src-tauri/Cargo.toml",
    "release:prepare": "node scripts/prepare-release.mjs",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/table-core": "^9.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "embla-carousel-svelte": "^8.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "formsnap": "^2.1.0",
    "globals": "^17.13.0",
    "kill-port": "^2.0.1",
    "layerchart": "^2.9.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "sveltekit-superforms": "^3.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@battlefieldduck/xterm-svelte": "^2.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/svelte": "^5.2.3",
    "@tanstack/svelte-query": "^6.3.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "devicon": "^2.17.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
